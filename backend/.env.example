APP_NAME=PropertyHub API
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-strong-32-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./propertyhub.db
# PostgreSQL example: postgresql+psycopg://<db-user>:<db-password>@localhost:5432/<db-name>
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false
RECURRING_TASK_GENERATION_ENABLED=true
RECURRING_TASK_GENERATION_HOUR=6
RECURRING_TASK_GENERATION_MINUTE=0
DOCUMENT_STORAGE_DIR=./storage/documents
FRONTEND_APP_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PropertyHub
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-bootstrap-password
BOOTSTRAP_ADMIN_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
