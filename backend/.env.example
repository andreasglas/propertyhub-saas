APP_NAME=PropertyHub API
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-strong-32-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./propertyhub.db
# PostgreSQL example: postgresql+psycopg://<db-user>:<db-password>@localhost:5432/<db-name>
REDIS_URL=redis://localhost:6379/0
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-bootstrap-password
